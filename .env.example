# Compose local configuration. Copy to .env; never commit real credentials.
# Use a URL-safe random password (hex avoids URL-encoding surprises).
POSTGRES_USER=signaldesk
POSTGRES_DB=signaldesk
POSTGRES_PASSWORD=
APP_BIND=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
SESSION_SECONDS=28800
# For host development export DATABASE_URL explicitly:
# DATABASE_URL=postgresql+psycopg://signaldesk:YOUR_PASSWORD@localhost:5432/signaldesk
# Legacy SQLite remains supported only for compatibility and safe migration.
